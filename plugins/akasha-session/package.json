      "patch": "./cordis.patch.yml"
    },
    "compatibility": {
      "dshReleases": {
        "0.2.0-rc.2": "compatible",
        "0.2.1-alpha.1": "compatible",
        "0.2.1-alpha.2": "compatible"
      }
    }
  }
